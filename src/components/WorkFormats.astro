---
const formats = [
	{
		title: 'Консультация',
		duration: 'Однократная встреча',
		description:
			'Для прояснения ситуации, первичной поддержки и понимания следующего шага.',
	},
	{
		title: 'Краткосрочное консультирование',
		duration: '1–15 встреч',
		description:
			'Сфокусированная работа с конкретным запросом и устойчивыми изменениями в повседневной жизни.',
	},
	{
		title: 'Среднесрочное консультирование',
		duration: '15–30 встреч',
		description:
			'Работа с повторяющимися жизненными сценариями и осознанием внутренних причин, которые к ним приводят.',
	},
	{
		title: 'Долгосрочная терапия',
		duration: '20+ встреч',
		description:
			'Глубинная работа с личностными паттернами, травматическим опытом и сложными состояниями.',
	},
]
---

<section
	id="formats"
	class="section-space"
	aria-labelledby="formats-heading"
>
	<div class="container-narrow">
		<header class="max-w-2xl" data-reveal>
			<h2 id="formats-heading" class="section-title">Форматы работы</h2>
			<p class="section-lead">
				Формат подбирается совместно — исходя из запроса, состояния
				и задач, которые важны на текущем этапе.
			</p>
		</header>

		<ul
			class="reveal-stagger mt-12 grid gap-5 sm:grid-cols-2"
			role="list"
		>
			{
				formats.map((item) => (
					<li
						class="card-lift flex h-full flex-col rounded-[1rem] border border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] bg-[var(--color-bg)] p-8"
						data-reveal
					>
						<p class="text-xs font-medium uppercase tracking-[0.18em] text-[var(--color-accent-dark)]">
							{item.duration}
						</p>
						<h3 class="mt-5 font-display text-2xl text-[var(--color-text)]">
							{item.title}
						</h3>
						<p class="mt-4 flex-1 text-[0.975rem] leading-relaxed text-[var(--color-muted)]">
							{item.description}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
