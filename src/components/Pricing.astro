---
const prices = [
	{
		title: 'Индивидуальная консультация',
		price: '120 BYN',
		duration: '50 минут',
	},
	{
		title: 'Семейная консультация',
		price: '150 BYN',
		duration: '60 минут',
	},
	{
		title: 'Групповой формат',
		price: '90 BYN',
		duration: 'За 1 встречу',
	},
]
---

<section
	id="pricing"
	class="section-space bg-[var(--color-surface)]"
	aria-labelledby="pricing-heading"
>
	<div class="container-narrow">
		<header class="mx-auto max-w-2xl text-center" data-reveal>
			<h2 id="pricing-heading" class="section-title">Стоимость</h2>
			<p class="section-lead mx-auto">
				Прозрачные условия. Формат и длительность работы обсуждаются
				индивидуально.
			</p>
		</header>

		<ul
			class="reveal-stagger mx-auto mt-12 grid max-w-lg gap-5 lg:max-w-none lg:grid-cols-3 lg:gap-6"
			role="list"
		>
			{
				prices.map((item) => (
					<li
						class="card-lift rounded-[1rem] bg-[var(--color-bg)] px-7 py-8 text-center sm:px-10 sm:py-10 lg:px-6 lg:py-9 xl:px-8 xl:py-10"
						data-reveal
					>
						<h3 class="font-display text-balance text-xl text-[var(--color-text)] sm:text-2xl lg:text-[1.35rem] xl:text-2xl">
							{item.title}
						</h3>
						<p class="mt-5 font-display text-4xl tracking-tight text-[var(--color-accent-dark)] sm:mt-6 sm:text-5xl lg:text-4xl xl:text-5xl">
							{item.price}
						</p>
						<p class="mt-3 text-[0.9375rem] text-[var(--color-muted)] sm:text-base">
							{item.duration}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
