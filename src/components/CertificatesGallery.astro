---
import { certificates } from '../data/certificates'
---

<section
	id="certificates"
	class="section-space bg-[var(--color-surface)]"
	aria-labelledby="certificates-heading"
>
	<div class="container-narrow">
		<header class="max-w-2xl" data-reveal>
			<h2 id="certificates-heading" class="section-title">
				Дипломы и сертификаты
			</h2>
			<p class="section-lead">
				Документы об образовании и профессиональной квалификации.
				Нажмите на изображение, чтобы открыть в полном размере.
			</p>
		</header>

		<div
			id="certificates-gallery"
			class="reveal-stagger mt-12 columns-2 gap-3 md:columns-3 md:gap-4 lg:columns-4"
			role="list"
		>
			{
				certificates.map((item) => (
					<figure
						class="mb-5 break-inside-avoid md:mb-6"
						data-reveal
						role="listitem"
					>
						<a
							href={item.src}
							class="media-zoom group block overflow-hidden rounded-[var(--radius-soft)] bg-[var(--color-bg)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-dark)]"
							data-pswp-width={item.width}
							data-pswp-height={item.height}
							data-cropped="false"
							aria-label={`Открыть: ${item.title}`}
						>
							<img
								src={item.src}
								alt={item.alt}
								width={item.width}
								height={item.height}
								class="h-auto w-full object-cover"
								loading="lazy"
								decoding="async"
							/>
						</a>
						<figcaption class="mt-2.5 px-0.5 text-[0.8125rem] leading-snug text-[var(--color-muted)] md:text-sm">
							{item.title}
						</figcaption>
					</figure>
				))
			}
		</div>
	</div>
</section>

<style is:global>
	.pswp {
		--pswp-bg: #2b2b2b;
	}

	.pswp__bg {
		background: #2b2b2b;
	}

	.pswp__button--close,
	.pswp__button--zoom,
	.pswp__button--arrow--prev,
	.pswp__button--arrow--next {
		color: #f7f5f1;
	}

	.pswp__custom-caption {
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		padding: 0.875rem 1.25rem 1.25rem;
		background: rgb(43 43 43 / 0.92);
		color: #f7f5f1;
		font-size: 0.9375rem;
		line-height: 1.4;
		text-align: center;
	}
</style>

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox'
	import 'photoswipe/style.css'

	function initCertificatesGallery() {
		const gallery = document.querySelector('#certificates-gallery')
		if (!gallery) return

		const lightbox = new PhotoSwipeLightbox({
			gallery: '#certificates-gallery',
			children: 'a',
			pswpModule: () => import('photoswipe'),
			preload: [1, 2],
			padding: { top: 24, bottom: 56, left: 16, right: 16 },
			bgOpacity: 0.92,
			wheelToZoom: true,
		})

		lightbox.on('uiRegister', () => {
			lightbox.pswp?.ui?.registerElement({
				name: 'custom-caption',
				order: 9,
				isButton: false,
				appendTo: 'root',
				html: '',
				onInit: (el) => {
					lightbox.pswp?.on('change', () => {
						const slideEl = lightbox.pswp?.currSlide?.data.element
						const caption =
							slideEl?.querySelector('img')?.getAttribute('alt') ?? ''
						el.textContent = caption
					})
				},
			})
		})

		lightbox.init()
	}

	initCertificatesGallery()
	document.addEventListener('astro:page-load', initCertificatesGallery)
</script>
