---
import { certificates } from '../data/certificates'
---

<section
	id="certificates"
	class="section-space bg-[var(--color-surface)]"
	aria-labelledby="certificates-heading"
>
	<div class="container-narrow">
		<header class="max-w-2xl" data-reveal>
			<h2 id="certificates-heading" class="section-title">
				Дипломы и сертификаты
			</h2>
			<p class="section-lead">
				Документы об образовании и профессиональной квалификации.
				Нажмите на изображение, чтобы открыть в полном размере.
			</p>
		</header>

		<div
			id="certificates-gallery"
			class="reveal-stagger mt-12 columns-2 gap-3 md:columns-3 md:gap-4 lg:columns-4"
			role="list"
		>
			{
				certificates.map((item) => (
					<a
						href={item.src}
						class="media-zoom group mb-3 block break-inside-avoid overflow-hidden rounded-[var(--radius-soft)] bg-[var(--color-bg)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent-dark)] md:mb-4"
						data-reveal
						data-pswp-width={item.width}
						data-pswp-height={item.height}
						data-cropped="false"
						role="listitem"
						aria-label={`Открыть: ${item.title}`}
					>
						<img
							src={item.src}
							alt={item.alt}
							width={item.width}
							height={item.height}
							class="h-auto w-full object-cover"
							loading="lazy"
							decoding="async"
						/>
						<span class="sr-only">{item.title}</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style is:global>
	.pswp {
		--pswp-bg: #2b2b2b;
	}

	.pswp__bg {
		background: #2b2b2b;
	}

	.pswp__button--close,
	.pswp__button--zoom,
	.pswp__button--arrow--prev,
	.pswp__button--arrow--next {
		color: #f7f5f1;
	}
</style>

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox'
	import 'photoswipe/style.css'

	function initCertificatesGallery() {
		const gallery = document.querySelector('#certificates-gallery')
		if (!gallery) return

		const lightbox = new PhotoSwipeLightbox({
			gallery: '#certificates-gallery',
			children: 'a',
			pswpModule: () => import('photoswipe'),
			preload: [1, 2],
			padding: { top: 24, bottom: 24, left: 16, right: 16 },
			bgOpacity: 0.92,
			wheelToZoom: true,
		})

		lightbox.init()
	}

	initCertificatesGallery()
	document.addEventListener('astro:page-load', initCertificatesGallery)
</script>
