---
import { problems, problemNotes } from '../data/problems'
---

<section
	id="problems"
	class="section-space"
	aria-labelledby="problems-heading"
>
	<div class="container-narrow">
		<header class="max-w-2xl" data-reveal>
			<h2 id="problems-heading" class="section-title">
				Запросы, с которыми я работаю
			</h2>
			<p class="section-lead">
				Каждый запрос рассматривается индивидуально — с учётом состояния,
				контекста и целей, которые важны именно вам.
			</p>
		</header>

		<ul
			class="reveal-stagger mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
			role="list"
		>
			{
				problems.map((item) => (
					<li
						class="card-lift flex h-full flex-col rounded-[var(--radius-soft)] bg-[var(--color-surface)] p-6 md:p-7"
						data-reveal
					>
						<h3 class="font-display text-xl text-[var(--color-text)]">
							{item.title}
						</h3>
						<p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-[var(--color-muted)]">
							{item.description}
						</p>
					</li>
				))
			}
		</ul>

		<aside
			class="mt-14 border-t border-[color-mix(in_srgb,var(--color-text)_10%,transparent)] pt-10"
			aria-label="Уточнения по запросам"
			data-reveal
		>
			<ul class="max-w-3xl space-y-7" role="list">
				{
					problemNotes.map((note) => (
						<li class="flex gap-4">
							<span
								class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--color-accent)]"
								aria-hidden="true"
							/>
							<p class="text-[0.975rem] leading-relaxed text-[var(--color-muted)]">
								{note}
							</p>
						</li>
					))
				}
			</ul>
		</aside>
	</div>
</section>
