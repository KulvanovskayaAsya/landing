---
import { site } from '../data/site'

const credentials = [
	'Психолог',
	'Гештальт-терапевт',
	'Врач психиатр-нарколог',
	'Психотерапевт',
]
---

<section
	class="relative overflow-hidden"
	aria-labelledby="hero-heading"
>
	<div class="container-narrow relative">
		<div class="hero-layout min-h-[100svh] py-16 md:py-20">
			<p
				class="hero-eyebrow hero-enter mb-5 text-xs font-medium uppercase tracking-[0.22em] text-[var(--color-accent-dark)]"
				style="--hero-delay: 80ms"
			>
				Частная психотерапевтическая практика
			</p>

			<h1
				id="hero-heading"
				class="hero-title hero-enter max-w-[14ch] text-[clamp(2.25rem,5vw,3.75rem)] leading-[1.08] text-[var(--color-text)]"
				style="--hero-delay: 160ms"
			>
				{site.name}
			</h1>

			<ul
				class="hero-credentials hero-enter mt-7 flex flex-wrap gap-x-3 gap-y-2 text-[0.9375rem] text-[var(--color-muted)]"
				style="--hero-delay: 260ms"
				aria-label="Квалификации"
			>
				{
					credentials.map((item, index) => (
						<li class="flex items-center gap-3">
							{index > 0 && (
								<span
									class="hidden h-1 w-1 rounded-full bg-[var(--color-accent)] sm:inline-block"
									aria-hidden="true"
								/>
							)}
							<span>{item}</span>
						</li>
					))
				}
			</ul>

			<figure class="hero-portrait hero-enter-media relative mx-auto mt-8 w-full max-w-md md:mx-0 md:mt-0 md:max-w-none">
				<div
					class="media-zoom overflow-hidden rounded-[1.25rem] bg-[var(--color-surface)]"
				>
					<img
						src="/images/portraits/hero.jpg"
						alt={`Портрет — ${site.name}`}
						width="900"
						height="1200"
						class="aspect-[3/4] h-auto w-full object-cover"
						fetchpriority="high"
						decoding="async"
					/>
				</div>
			</figure>

			<p
				class="hero-desc hero-enter mt-8 max-w-[36rem] text-lg leading-relaxed text-[var(--color-muted)]"
				style="--hero-delay: 340ms"
			>
				Помогаю разобраться в себе, справиться с тревогой и кризисами,
				выстроить более устойчивые отношения с собой и окружающими.
			</p>

			<p
				class="hero-quote hero-enter mt-6 max-w-[34rem] border-l-2 border-[var(--color-accent)] pl-4 text-[0.9375rem] leading-relaxed text-[var(--color-text)]"
				style="--hero-delay: 420ms"
			>
				Медицинское образование и специализация по клинической
				психотерапии — основа работы с запросами высокой сложности.
			</p>

			<div
				class="hero-cta hero-enter mt-10 flex flex-wrap gap-3"
				style="--hero-delay: 520ms"
			>
				<a
					class="btn btn-primary"
					href={site.telegram}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Записаться в Telegram"
				>
					Записаться в Telegram
				</a>
				<a
					class="btn btn-secondary"
					href={site.instagram}
					target="_blank"
					rel="noopener noreferrer"
					aria-label="Открыть Instagram"
				>
					Instagram
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-layout {
		display: grid;
		align-content: center;
		gap: 0;
	}

	@media (min-width: 768px) {
		.hero-layout {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			column-gap: 4rem;
			align-items: center;
			grid-template-areas:
				'eyebrow portrait'
				'title portrait'
				'credentials portrait'
				'desc portrait'
				'quote portrait'
				'cta portrait';
		}

		.hero-eyebrow {
			grid-area: eyebrow;
		}

		.hero-title {
			grid-area: title;
		}

		.hero-credentials {
			grid-area: credentials;
		}

		.hero-portrait {
			grid-area: portrait;
			margin-top: 0;
		}

		.hero-desc {
			grid-area: desc;
		}

		.hero-quote {
			grid-area: quote;
		}

		.hero-cta {
			grid-area: cta;
		}
	}

	@media (min-width: 1024px) {
		.hero-layout {
			column-gap: 5rem;
		}
	}
</style>
