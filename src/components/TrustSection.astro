---
const items = [
	{
		title: 'Высшее медицинское образование',
		text: 'Клиническая база, необходимая для объёмного взгляда на ситуацию клиента.',
	},
	{
		title: 'Специализация по клинической психотерапии',
		text: 'Клинические аспекты психотерапии — моя основная специализация и область постоянного профессионального развития. Такой подход позволяет работать наиболее системно с симптомом.',
	},
	{
		title: 'Более 500 часов личной терапии',
		text: 'Постоянная личная терапия как этическая и профессиональная основа практики.',
	},
	{
		title: 'Более 300 часов супервизии',
		text: 'Регулярная профессиональная рефлексия и поддержка качества терапевтической работы.',
	},
	{
		title: 'Гештальт-подход',
		text: 'Работа с контактом, осознаванием и актуальным опытом в настоящем моменте.',
	},
	{
		title: 'Аналитико-ориентированный подход',
		text: 'Глубокий анализ, поиск причинно-следственных связей и детальный разбор структуры.',
	},
]
---

<section
	id="trust"
	class="section-space bg-[var(--color-surface)]"
	aria-labelledby="trust-heading"
>
	<div class="container-narrow">
		<header class="max-w-2xl" data-reveal>
			<h2 id="trust-heading" class="section-title">
				Основа профессионального подхода
			</h2>
			<p class="section-lead">
				Доверие рождается там, где есть глубокая подготовка, бережное отношение и устойчивый терапевтический опыт.
			</p>
		</header>

		<ul
			class="reveal-stagger mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
			role="list"
		>
			{
				items.map((item) => (
					<li
						class="card-lift rounded-[var(--radius-soft)] border border-[color-mix(in_srgb,var(--color-text)_8%,transparent)] bg-[var(--color-bg)] p-7 hover:border-[color-mix(in_srgb,var(--color-accent)_45%,transparent)]"
						data-reveal
					>
						<div
							class="mb-5 h-px w-10 bg-[var(--color-accent)]"
							aria-hidden="true"
						/>
						<h3 class="font-display text-xl leading-snug text-[var(--color-text)]">
							{item.title}
						</h3>
						<p class="mt-3 text-[0.9375rem] leading-relaxed text-[var(--color-muted)]">
							{item.text}
						</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
