---
import { site } from '../data/site'
import { navigation } from '../data/navigation'
---

<header class="site-header" data-site-header>
	<div class="container-narrow">
		<div class="site-header__bar">
			<a class="site-header__brand" href="#main">
				<span class="site-header__brand-name">{site.shortName}</span>
				<span class="site-header__brand-role">Психотерапевт</span>
			</a>

			<nav
				class="site-header__desktop"
				aria-label="Основная навигация"
			>
				<ul class="site-header__list">
					{
						navigation.map((item) => (
							<li>
								<a class="site-header__link" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
				<a
					class="btn btn-primary site-header__cta"
					href={site.telegram}
					target="_blank"
					rel="noopener noreferrer"
				>
					Записаться
				</a>
			</nav>

			<button
				class="site-header__burger"
				type="button"
				aria-expanded="false"
				aria-controls="mobile-nav"
				data-nav-toggle
			>
				<span class="sr-only">Открыть меню</span>
				<span class="site-header__burger-lines" aria-hidden="true">
					<span></span>
					<span></span>
					<span></span>
				</span>
			</button>
		</div>
	</div>

	<div
		id="mobile-nav"
		class="site-header__mobile"
		hidden
		data-mobile-nav
	>
		<nav aria-label="Мобильная навигация">
			<ul class="site-header__mobile-list">
				{
					navigation.map((item) => (
						<li>
							<a class="site-header__mobile-link" href={item.href}>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a
				class="btn btn-primary site-header__mobile-cta"
				href={site.telegram}
				target="_blank"
				rel="noopener noreferrer"
			>
				Записаться в Telegram
			</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--color-bg);
		border-bottom: 1px solid
			color-mix(in srgb, var(--color-text) 10%, transparent);
	}

	.site-header__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 4.25rem;
		gap: 1rem;
	}

	.site-header__brand {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		text-decoration: none;
		color: var(--color-text);
		min-width: 0;
	}

	.site-header__brand-name {
		font-family: var(--font-display);
		font-size: 1.05rem;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.site-header__brand-role {
		font-size: 0.6875rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent-dark);
	}

	.site-header__desktop {
		display: none;
		align-items: center;
		gap: 1.25rem;
	}

	.site-header__list {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.15rem 1rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-header__link {
		font-size: 0.875rem;
		color: var(--color-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.site-header__link:hover,
	.site-header__link:focus-visible {
		color: var(--color-text);
	}

	.site-header__cta {
		min-height: 2.5rem;
		padding: 0.55rem 1.15rem;
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.site-header__burger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75rem;
		height: 2.75rem;
		margin-right: -0.4rem;
		border: 0;
		background: transparent;
		color: var(--color-text);
		cursor: pointer;
	}

	.site-header__burger-lines {
		display: flex;
		width: 1.25rem;
		flex-direction: column;
		gap: 0.28rem;
	}

	.site-header__burger-lines span {
		display: block;
		height: 1.5px;
		width: 100%;
		background: currentColor;
		transition:
			transform 0.25s ease,
			opacity 0.25s ease;
	}

	.site-header.is-open .site-header__burger-lines span:nth-child(1) {
		transform: translateY(0.355rem) rotate(45deg);
	}

	.site-header.is-open .site-header__burger-lines span:nth-child(2) {
		opacity: 0;
	}

	.site-header.is-open .site-header__burger-lines span:nth-child(3) {
		transform: translateY(-0.355rem) rotate(-45deg);
	}

	.site-header__mobile {
		border-top: 1px solid
			color-mix(in srgb, var(--color-text) 10%, transparent);
		background: var(--color-bg);
		padding: 1rem 1.25rem 1.5rem;
	}

	.site-header__mobile[hidden] {
		display: none;
	}

	.site-header__mobile-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.site-header__mobile-link {
		display: block;
		padding: 0.85rem 0;
		border-bottom: 1px solid
			color-mix(in srgb, var(--color-text) 8%, transparent);
		font-family: var(--font-display);
		font-size: 1.25rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.site-header__mobile-link:hover,
	.site-header__mobile-link:focus-visible {
		color: var(--color-accent-dark);
	}

	.site-header__mobile-cta {
		width: 100%;
		margin-top: 1.25rem;
	}

	@media (min-width: 1100px) {
		.site-header__desktop {
			display: flex;
		}

		.site-header__burger {
			display: none;
		}

		.site-header__mobile {
			display: none !important;
		}
	}

	@media (max-width: 1099px) {
		.site-header__brand-name {
			font-size: 0.98rem;
		}
	}
</style>

<script>
	function initSiteHeader() {
		const header = document.querySelector<HTMLElement>('[data-site-header]')
		const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]')
		const panel = document.querySelector<HTMLElement>('[data-mobile-nav]')

		if (!header || !toggle || !panel) return

		const label = toggle.querySelector('.sr-only')

		const setOpen = (open: boolean) => {
			header.classList.toggle('is-open', open)
			toggle.setAttribute('aria-expanded', String(open))
			panel.hidden = !open
			document.body.style.overflow = open ? 'hidden' : ''
			if (label) {
				label.textContent = open ? 'Закрыть меню' : 'Открыть меню'
			}
		}

		toggle.addEventListener('click', () => {
			const isOpen = toggle.getAttribute('aria-expanded') === 'true'
			setOpen(!isOpen)
		})

		panel.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false))
		})

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false)
		})

		window.addEventListener('resize', () => {
			if (window.matchMedia('(min-width: 1100px)').matches) {
				setOpen(false)
			}
		})
	}

	initSiteHeader()
	document.addEventListener('astro:page-load', initSiteHeader)
</script>
